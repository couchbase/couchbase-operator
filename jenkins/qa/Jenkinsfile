/**
 * One pipeline to rule them all...
 * Warning, this belongs to development and must be fast and stable, do not modify without
 * good reason!
 */
pipeline {
  agent any

  options {
    timestamps()

    // Discard any stale builds so we don't fill up the disk.
    buildDiscarder(
      logRotator(
        artifactDaysToKeepStr: '30',
        artifactNumToKeepStr: '50',
        daysToKeepStr: '30',
        numToKeepStr: '50',
      )
    )

    // We only have a single cluster for now, control concurrency with other runs of this
    // job, or another job with a reservation on a global lockable resource.
    lock resource: 'gke-cluster-couchbase-operator-certification'
  }

  parameters {
    string(name: 'GERRIT_REFSPEC', defaultValue: 'refs/heads/master', description: 'Gerrit ref spec of your source tree (auto filled for comment triggered builds)')
    string(name: 'server_image', defaultValue: 'couchbase/server:8.0.0', , description: 'Version of Couchbase to test')
    string(name: 'server_image_version', defaultValue: '', , description: 'Override the version of Couchbase to test')
    string(name: 'server_image_upgrade', defaultValue: 'couchbase/server:7.6.11', description: 'Version of Couchbase to upgrade from')
    string(name: 'server_image_upgrade_version', defaultValue: '', description: 'Override the version of Couchbase to upgrade from')
    string(name: 'backup_image', defaultValue: 'ghcr.io/cb-vanilla/operator-backup:latest', description: 'Version of the Couchbase backup image to test')
    string(name: 'exporter_image', defaultValue: 'cb-vanilla/exporter:latest', description: 'Version of the Prometheus exporter to test')
    string(name: 'exporter_image_upgrade', defaultValue: 'cb-vanilla/exporter:1.0.9', description: 'Version of the Prometheus exporter to upgrade from')
    string(name: 'logging_image', defaultValue: 'ghcr.io/cb-vanilla/fluent-bit:latest', description: 'Version of the log shipping sidecar to test')
    string(name: 'logging_image_upgrade', defaultValue: 'couchbase/fluent-bit:1.3.0', description: 'Version of the log shipping sidecar to upgrade from')
    string(name: 'cloud_native_gateway_image', defaultValue: 'ghcr.io/cb-vanilla/cloud-native-gateway:latest', description: 'Image to use for the cloud native gateway deployment')
    string(name: 'mobile_image', defaultValue: 'cb-vanilla/sync-gateway:2.8.3-enterprise', description: 'Version of Sync-Gateway to test')
    choice(name: 'bucket_type', choices: ['couchbase', 'ephemeral', 'memcached'], description: 'Bucket type to test with, for tests where bucket type is dynamic')
    choice(name: 'compression_mode', choices: ['passive', 'active', 'off'], description: 'Bucket compression to test with, for tests where compression is dynamic')
    booleanParam(name: 'sanity', defaultValue: true, description: 'Run the sanity test suite')
    booleanParam(name: 'p0', defaultValue: false, description: 'Run the p0 test suite')
    booleanParam(name: 'p1', defaultValue: false, description: 'Run the p1 test suite')
    booleanParam(name: 'system', defaultValue: false, description: 'Run the system test suite')
    booleanParam(name: 'platform', defaultValue: false, description: 'Run the platform test suite')
    string(name: 'features', defaultValue: '', description: 'Much like a suite, these feature sets allow functional area testing e.g. "backup"')
    string(name: 'tests', defaultValue: '', description: 'Any custom tests to run, this is a space delimited list of tests names e.g. "TestCreateCluster TestCreateBucketCluster"')
  }

  triggers {
    // Lets you start this pipeline straight from a Gerrit review, just by leaving a
    // comment. Comment "CI tls cng p0" and it runs the tls and cng tests plus the p0
    // suite on your change. Any comment that starts with "CI" (case-insensitive) kicks
    // off a build. The words after "CI" are read in the 'Resolve Suites' stage below, and
    // your patchset is checked out automatically via the GERRIT_REFSPEC parameter.
    gerrit(
      serverName: 'review.couchbase.org',
      // silentMode stops the plugin posting its own "Build Started/Successful/..." comments and
      // votes for this job, so the only feedback on the review is our own [CI] result comment.
      silentMode: true,
      gerritProjects: [[
        compareType: 'PLAIN',
        pattern: 'couchbase-operator',
        branches: [[compareType: 'ANT', pattern: '**']],
      ]],
      triggerOnEvents: [commentAddedContains(commentAddedCommentContains: '(?im)^\\s*CI\\s+\\S+')],
    )
  }

  environment {
    GOVERSION = "1.26.4"
    GOBIN = "${env.WORKSPACE}/bin"
    GOROOT = "${env.WORKSPACE}/go"
    PATH = "${env.GOBIN}:${env.WORKSPACE}/go/bin:${env.WORKSPACE}/kind/bin:${env.WORKSPACE}/google-cloud-sdk/bin:$PATH"
    DOCKER_CREDENTIALS = credentials('dockerhub-couchbaseqe')
    GITLAB_CREDENTIALS = credentials('gitlab-couchbaseqe')
    GHCR_CREDENTIALS = credentials('couchbaseqe-ghrc')
    GCLOUD_SERVICE_TOKEN = credentials('google-cloud-couchbase-operator')
    AWS_CREDENTIALS = credentials('aws-alex')
    AZURE_CREDENTIALS = credentials('azure-alex')
    GCP_CREDENTIALS = credentials('gcp-operator')
    GCP_REFRESH_TOKEN = credentials('gcp-refresh-token')
    KIND_VERSION = "0.31.0"
  }

  stages {
    stage('Build Name') {
      steps {
        // The build name must be unique, or the JUnit trend will crap out.
        buildName "#${BUILD_NUMBER} ${sh(script: 'git log --oneline --format=%B HEAD | head -n 1', returnStdout: true)}"
        buildDescription "Patchset: ${params.GERRIT_REFSPEC.split('/').last()}"
      }
    }

    stage('Resolve Suites') {
      steps {
        script {
          // Figure out which suites to run. If the build came from a Gerrit comment like
          // "CI tls cng p0", we use those words, each one becomes a "-suite <word>" flag
          // (cao certify treats suites and feature sets the same, so you can mix them).
          // If someone started the build manually instead, we read the checkboxes and the
          // features field. Either way the validation suite still runs on its own, in the
          // 'Validation Test' stage further down.
          def tokens = parseCiComment(env.GERRIT_EVENT_COMMENT_TEXT ?: '')
          def suites = []
          if (tokens) {
            echo "Triggered by Gerrit comment, running: ${tokens.join(' ')}"
            suites = tokens.collect { "-suite ${it}" }
          } else {
            if (params.sanity)   { suites << '-suite sanity' }
            if (params.p0)       { suites << '-suite p0' }
            if (params.p1)       { suites << '-suite p1' }
            if (params.system)   { suites << '-suite system' }
            if (params.platform) { suites << '-suite platform' }
            suites += params.features.split().collect { "-suite ${it}" }
          }
          env.SUITE_ARGS = suites.join(' ')
          env.TEST_ARGS  = params.tests.split().collect { "-test ${it}" }.join(' ')
        }
      }
    }

    stage('Install Go') {
      steps {
        sh 'wget -q -O- https://dl.google.com/go/go${GOVERSION}.linux-amd64.tar.gz | tar xz'
      }
    }

    stage('Install Google Cloud SDK') {
      steps {
        sh 'wget -q -O- https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-sdk-432.0.0-linux-x86_64.tar.gz | tar xz'
        sh 'gcloud components install kubectl'
        sh 'gcloud auth activate-service-account couchbase-operator@couchbase-engineering.iam.gserviceaccount.com --project couchbase-engineering --key-file ${GCLOUD_SERVICE_TOKEN}'
        sh 'KUBECONFIG=config gcloud container clusters get-credentials couchbase-operator-ci-certification --region us-east1'
      }
    }

    stage('Install Kind') {
      steps {
        sh 'mkdir -p kind/bin'
        sh 'curl -Lo kind/bin/kind https://kind.sigs.k8s.io/dl/v${KIND_VERSION}/kind-linux-amd64'
        sh 'chmod +x kind/bin/kind'
      }
    }

    stage('Build Binaries') {
      steps {
        sh 'make touch-generated tools'
      }
    }

    stage('Build Container Images') {
      steps {
        sh 'docker login -u ${DOCKER_CREDENTIALS_USR} -p ${DOCKER_CREDENTIALS_PSW}'
        sh 'docker login dhi.io -u ${DOCKER_CREDENTIALS_USR} -p ${DOCKER_CREDENTIALS_PSW}'
        sh 'make images-public -e DOCKER_USER=${DOCKER_CREDENTIALS_USR} DOCKER_TAG=${GIT_COMMIT}'
      }

      post {
        always {
          // Remove old docker images now, this stops disk from filling up and minimises risk
          // of this not being called due to a job cancellation.
          sh 'make images-clean -e DOCKER_USER=${DOCKER_CREDENTIALS_USR} DOCKER_TAG=${GIT_COMMIT}'
        }
      }
    }

    stage('Validation Test') {
      matrix {
        axes {
          axis {
            name 'version'
            values 'v1.35.5', 'v1.34.8'
          }
        }

        stages {
          stage('Validation Test') {
            steps {
              sh 'kind create cluster --name ${version} --image kindest/node:${version} --kubeconfig kubeconfig.${version}'
              sh 'KUBECONFIG=${WORKSPACE}/kubeconfig.${version} kubectl get nodes'
              sh 'KUBECONFIG=${WORKSPACE}/kubeconfig.${version} kubectl wait --for=condition=Ready nodes --all --timeout=10m'
              sh 'KUBECONFIG=${WORKSPACE}/kubeconfig.${version} kubectl describe nodes'
              // This test is kinda special in that it can be run with huge parallelism
              // and consumes no actual resources, so -ignore-errors is a bit of a fudge.
              sh 'KUBECONFIG=${WORKSPACE}/kubeconfig.${version} ./build/bin/kubernetes-linux-amd64/cao \
                certify \
                --image ${DOCKER_CREDENTIALS_USR}/couchbase-operator-certification:${GIT_COMMIT} \
                --timeout 10m \
                --parallel 8 \
                --archive-name logs-${version} \
                --parallel 8 \
                -- \
                -suite validation \
                -suite-suffix ${version} \
                -operator-image ${DOCKER_CREDENTIALS_USR}/couchbase-operator:${GIT_COMMIT} \
                -admission-image ${DOCKER_CREDENTIALS_USR}/couchbase-admission-controller:${GIT_COMMIT} \
                -ignore-errors'
              sh 'tar xf logs-${version}.tar.bz2'
            }

            post {
              always {
                sh 'kind delete cluster --name ${version}'
              }
            }
          }
        }
      }
    }

    stage('Acceptance Test') {
      stages {
        stage('Run Tests') {
          steps {
            // Warn if something went wrong, but don't fail, it's probably just an unstable test/platform.
            warnError('Suite failed') {
              sh "KUBECONFIG=${WORKSPACE}/config ./build/bin/kubernetes-linux-amd64/cao \
                certify \
                --clean \
                --parallel 8 \
                --image \${DOCKER_CREDENTIALS_USR}/couchbase-operator-certification:${GIT_COMMIT} \
                --archive-name logs \
                --profile \
                --profile-dir profile \
                -- \
                ${env.SUITE_ARGS} \
                ${env.TEST_ARGS} \
                -platform-type kubernetes \
                -operator-image \${DOCKER_CREDENTIALS_USR}/couchbase-operator:\${GIT_COMMIT} \
                -admission-image \${DOCKER_CREDENTIALS_USR}/couchbase-admission-controller:\${GIT_COMMIT} \
                -mobile-image \${mobile_image} \
                -server-image \${server_image} \
                ${params.server_image_version ? "-server-image-version ${params.server_image_version}" : ''} \
                -server-image-upgrade \${server_image_upgrade} \
                ${params.server_image_upgrade_version ? "-server-image-upgrade-version ${params.server_image_upgrade_version}" : ''} \
                -exporter-image \${exporter_image} \
                -exporter-image-upgrade \${exporter_image_upgrade} \
                -backup-image \${backup_image} \
                -logging-image \${logging_image} \
                -logging-image-upgrade \${logging_image_upgrade} \
                -cloud-native-gateway-image ${params.cloud_native_gateway_image} \
                -storage-class standard-rwo \
                -bucket-type \${bucket_type} \
                -compression-mode \${compression_mode} \
                -registry https://index.docker.io/v1/,\${DOCKER_CREDENTIALS_USR},\${DOCKER_CREDENTIALS_PSW} \
                -registry=https://ghcr.io/,\${GHCR_CREDENTIALS_USR},\${GHCR_CREDENTIALS_PSW} \
                -collect-logs \
                -collect-server-logs=false \
                -s3-access-key \${AWS_CREDENTIALS_USR} \
                -s3-secret-id \${AWS_CREDENTIALS_PSW} \
                -az-account-name \${AZURE_CREDENTIALS_USR} \
                -az-account-key \${AZURE_CREDENTIALS_PSW} \
                -gcp-client-id \${GCP_CREDENTIALS_USR} \
                -gcp-client-secret \${GCP_CREDENTIALS_PSW} \
                -gcp-refresh-token \${GCP_REFRESH_TOKEN}"
            }
          }
        }

        stage('Extract Logs') {
          steps {
            sh 'tar xf logs.tar.bz2'
          }
        }

        stage('Extract Results') {
          steps {
            sh 'tar xf results.tar.bz'
          }
        }
      }
    }
  }

  post {
    always {
      // Save JUnit results. allowEmptyResults so a run with no results doesn't fail here,
      // and grab the summary to post back to Gerrit.
      script {
        def summary = junit testResults: 'artifacts/*.xml', allowEmptyResults: true

        // If a Gerrit comment triggered this, post the result back on the review. We do it
        // over ssh with the same ns-codereview key the Gerrit Trigger plugin uses. Just a
        // comment, no vote, a human still reviews and votes. Wrapped in try/catch so a problem
        // posting the comment can never fail the build itself.
        if (env.GERRIT_CHANGE_NUMBER) {
          try {
            // gerrit re-parses the ssh command on the server, so the message has to reach it
            // quoted, double quotes for gerrit, wrapped in single quotes for the local shell.
            def msg = buildResultComment(summary)
            sh """
              ssh -i /var/lib/jenkins/.ssh/id_rsa -p 29418 -o StrictHostKeyChecking=no \
                ns-codereview@review.couchbase.org \
                gerrit review ${env.GERRIT_PATCHSET_REVISION} --message '"${msg}"'
            """
          } catch (err) {
            echo "Could not post result to Gerrit: ${err}"
          }
        }
      }

      // Archive any logs as an artifact, these may be needed to debug an issue.
      sh 'tar czf logs.tar.gz artifacts/logs'
      archiveArtifacts artifacts: 'logs.tar.gz', fingerprint: true

      // Archive profiling data so we can debug the certification image.
      sh 'tar czf profile.tar.gz profile'
      archiveArtifacts artifacts: 'profile.tar.gz', fingerprint: true

      // Make a pretty graph.
      sh 'go run scripts/metrics.go --path profile > data.csv'
      sh 'gnuplot scripts/metrics.gnuplot > metrics.png'
      archiveArtifacts artifacts: 'metrics.png'
 
    }
    cleanup {
      // Clean up the workspace to free disk space.
      cleanWs()
    }
  }
}

// parseCiComment pulls the suite/feature tokens out of a Gerrit "CI ..." comment and returns
// them back as a list, e.g. "CI tls cng p0" -> ['tls', 'cng', 'p0']. If it isn't a CI comment
// (or the build was manually done), it returns null and the pipeline just uses its build parameters
// instead.

// Gerrit doesn't hand us the comment as plain text, it base64 encodes it and sticks a
// "Patch Set N:" line on the front. So we try to decode it first, fall back to the raw text
// if that fails, and then let the regex pick out the "CI ..." line from whichever we've got.
// It's marked @NonCPS because the regex matcher can't be saved to disk, so it has to run in
// one shot and not survive across pipeline steps.
@NonCPS
def parseCiComment(String raw) {
  if (!raw?.trim()) {
    return null
  }
  def candidates = []
  try {
    candidates << new String(raw.decodeBase64(), 'UTF-8')
  } catch (ignored) {
    // not valid base64 -> fall through to the raw value
  }
  candidates << raw
  for (comment in candidates) {
    def matcher = (comment =~ /(?im)^\s*CI\s+(.+?)\s*$/)
    if (matcher.find()) {
      return matcher.group(1).trim().split(/\s+/) as List
    }
  }
  return null
}

// buildResultComment builds the message we post back on the Gerrit review: the result, the
// suites that ran, pass/fail counts and a link to the run. The message must NOT start with
// "CI " or it would match the trigger regex and the comment would trigger another build.
def buildResultComment(summary) {
  def suites = (env.SUITE_ARGS ?: '').replaceAll('-suite ', '').trim()
  def header = "[CI] ${currentBuild.currentResult}" + (suites ? " (${suites})" : "")

  if (summary == null || summary.totalCount == 0) {
    return "${header} - no test results were produced (the run may have failed before tests ran). ${env.BUILD_URL}"
  }

  def line = "${header} - ${summary.passCount}/${summary.totalCount} passed, ${summary.failCount} failed. ${env.BUILD_URL}"
  if (summary.failCount == 0) {
    return line
  }

  def names = failingTestNames()
  if (names.isEmpty()) {
    return line
  }

  def shown = names.take(20)
  def more  = names.size() > 20 ? " (+${names.size() - 20} more)" : ""
  return line + " Failing: " + shown.join(", ") + more
}

// failingTestNames returns the names of the failed tests, read from the JUnit XML.
// If anything goes wrong it just returns an empty list so the comment still posts.
def failingTestNames() {
  try {
    def names = []
    for (f in findFiles(glob: 'artifacts/*.xml')) {
      names.addAll(parseFailedTestNames(readFile(f.path)))
    }
    return names
  } catch (err) {
    echo "Could not extract failing test names: ${err}"
    return []
  }
}

// parseFailedTestNames returns the failed/errored testcase names from one JUnit XML file
// using XmlParser. @NonCPS because the parsed Nodes can't cross pipeline steps.
@NonCPS
def parseFailedTestNames(String xml) {
  def root = new groovy.util.XmlParser(false, false).parseText(xml)
  return root.depthFirst().findAll { node ->
    node instanceof groovy.util.Node && node.name() == 'testcase' &&
      node.children().any { c -> c instanceof groovy.util.Node && (c.name() == 'failure' || c.name() == 'error') }
  }.collect { it.attribute('name') }
}
