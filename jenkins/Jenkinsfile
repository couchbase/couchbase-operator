pipeline {
  agent {
    label 'docker'
  }

  options {
    timestamps()
  }

  environment {
    GOBIN = "${env.WORKSPACE}/bin"
    NODEVERSION = '16.0.0'
    // Default GOPATH (~/go): modules, like the build cache in ~/.cache, survive
    // cleanWs() when the agent is reused.
    PATH = "${env.GOBIN}:${env.WORKSPACE}/go/bin:${env.WORKSPACE}/node-v${env.NODEVERSION}-linux-x64/bin:${PATH}"
    MAKEFLAGS = "--no-builtin-rules"
  }

  stages {
    stage('Go Install') {
      steps {
        // Install the Go version go.mod asks for, so the two can't drift.
        sh '''
          version=$(awk '/^go /{print $2}' go.mod)
          wget -q -O- https://dl.google.com/go/go${version}.linux-amd64.tar.gz | tar xz
        '''
        // Mark go/ as its own module so ./... patterns skip the toolchain.
        sh 'touch go/go.mod'
      }
    }
    stage('Post Checkout') {
      steps {
        sh 'make touch-generated'
      }
    }
    stage('Verify') {
      parallel {
        stage('Go Lint') {
          steps {
            sh 'make lint'
          }
        }
        stage('Python Lint') {
          steps {
            sh 'python3 -m venv venv'
            sh '. venv/bin/activate && pip3 install -r scripts/requirements.txt'
            sh '. venv/bin/activate && make lint-python'
          }
        }
        stage('Build Developer') {
          steps {
            sh 'make all'
          }
        }
        stage('Generated Code') {
          steps {
            sh 'make verify-generated'
          }
        }
        stage('Unit Test') {
          steps {
            sh 'make test-unit'
          }
        }
        stage('Documentation') {
          steps {
            // Only the docs build needs Node, so install it off the critical path.
            sh 'wget -q -O- https://nodejs.org/dist/v${NODEVERSION}/node-v${NODEVERSION}-linux-x64.tar.xz | tar xJ'
            sh 'make docs-lint'
          }
        }
      }
    }
  }

  post {
    always {
      cleanWs()
    }
  }
}
